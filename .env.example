# ==============================================================================
# RBX GAMING CAFE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Cloud Database Credentials
# Obtain these from your Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional Payment Gateway Key (e.g. Razorpay)
# Leave empty to use verified UPI QR & manual reference verification workflow
VITE_RAZORPAY_KEY_ID=
